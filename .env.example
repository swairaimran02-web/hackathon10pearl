# Copy this file to .env and fill in your own values. Never submit .env.
#
# Model provider: anthropic | google | openai  (only these are allowed)
MODEL_PROVIDER=google
# Primary model ID (copy the exact ID from Google AI Studio / the provider).
MODEL_NAME=gemini-3.5-flash-lite
# Backup model used automatically if the primary fails.
FALLBACK_MODEL_NAME=gemini-3.1-flash-lite

# Provider API key (only the one you use is required).
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional tuning
TEMPERATURE=0
MAX_RETRIES=4
RETRY_BACKOFF_SECONDS=5
# CACHE_DIR=.cache
